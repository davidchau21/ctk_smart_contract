# Smart Contracts Deployment & Verification Environment Variables
# Copy to .env in this directory or in the root project directory

# Private key of the deployer wallet (DO NOT commit real private keys)
PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# RPC URLs
SEPOLia_RPC_URL="https://rpc2.sepolia.org"
BSC_TESTNET_RPC_URL="https://data-seed-prebsc-1-s1.binance.org:8545"

# Block Explorer API Keys for automated source verification
# Get free keys at https://etherscan.io and https://bscscan.com
ETHERSCAN_API_KEY="your_etherscan_api_key_here"
BSCSCAN_API_KEY="your_bscscan_api_key_here"

